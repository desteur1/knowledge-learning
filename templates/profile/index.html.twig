{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/styles/profil.css') }}">
{% endblock %}

{% block body %}
<div class="profile-container">

    <h1>Mon profil</h1>

    <div class="profile-card">

    {% for message in app.flashes('success') %}
    <div class="flash-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="flash-error">{{ message }}</div>
    {% endfor %}

        <p><strong>Email :</strong> {{ user.email }}</p>

        <p>
            <strong>Statut :</strong>
            {% if user.isVerified %}
                <span class="verified">✔ Vérifié</span>
            {% else %}
                <span class="not-verified">✖ Non vérifié</span>
                <br>
                <a href="{{ path('app_resend_verification_email') }}" class="btn">Vérifier mon email</a>
            {% endif %}
        </p>

        {% if 'ROLE_ADMIN' in user.roles %}
            <p><strong>Rôle :</strong> Administrateur</p>
        {% else %}
            <p><strong>Rôle :</strong> Utilisateur</p>
        {% endif %}


        <a href="{{ path('app_change_password') }}" class="btn">Changer mon mot de passe</a>
    </div>

</div>


{% endblock %}
