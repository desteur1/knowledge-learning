<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">


        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>
<nav class="navbar">

    <div class="navbar-left">
        <a href="{{ path('app_home') }}" class="logo">
            <img src="{{ asset('images/logo.jpg') }}" alt="Logo">
        </a>
    </div>

    <div class="navbar-right" id="menu">

    {% if app.user %}
        <a href="{{ path('app_my_courses') }}">Mes cours</a>
        <a href="{{ path('my_certifications') }}">Mes certifications</a>
        <a href="{{ path('app_profile') }}">Mon profil</a>
        <a href="{{ path('app_logout') }}">Déconnexion</a>
    {% else %}
        <a href="{{ path('app_login') }}">Connexion</a>
        <a href="{{ path('app_register') }}">Inscription</a>
    {% endif %}

</div>

</nav>

        {# Messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}

        <script>
            // Faire disparaître les messages flash après 10 secondes
            setTimeout(() => {
                document.querySelectorAll('.alert').forEach(el => {
                    el.style.transition = "opacity 0.5s";
                    el.style.opacity = "0";
                    setTimeout(() => el.remove(), 500);
                });
            }, 10000);
        </script>

    </body>
</html>
