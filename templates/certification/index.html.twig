{% extends 'base.html.twig' %}

{% block title %}Mes certifications{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/styles/certification.css') }}">
{% endblock %}

{% block body %}

<div class="certifications-wrapper">

    <h1 class="certifications-title">Mes certifications</h1>

    {% if certifications is empty %}
        <p class="no-certification">Aucune certification obtenue pour le moment.</p>
    {% else %}
        <ul class="certifications-list">
            {% for cert in certifications %}
                <li class="certification-item">
                    🎓 <strong>{{ cert.cursus.name }}</strong>
                    Obtenue le : {{ cert.obtainedAt|date('d/m/Y') }}

                    <div>
                        <a href="{{ path('cursus_show', {id: cert.cursus.id}) }}" class="btn-view">
                            Voir le cursus
                        </a>

                        <a href="{{ path('certification_download', { id: cert.id }) }}" class="btn-download">
                            Télécharger en PDF
                        </a>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

</div>

{% endblock %}
